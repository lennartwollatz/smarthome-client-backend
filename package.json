{
  "name": "smarthome-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json && npm run copy:migrations",
    "copy:migrations": "node -e \"require('node:fs').cpSync('src/db/migrations', 'dist/db/migrations', { recursive: true })\"",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@matter/main": "^0.16.10",
    "@matter/nodejs": "^0.16.10",
    "@matter/nodejs-ble": "^0.15.6",
    "@project-chip/matter.js": "^0.16.10",
    "bmw-connected-drive": "^2.4.0",
    "cors": "^2.8.5",
    "dav": "^1.8.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "miio": "^0.15.6",
    "multicast-dns": "^7.2.0",
    "mysql2": "^3.14.0",
    "node-hue-api": "^4.0.8",
    "pino": "^9.0.0",
    "pino-http": "^9.0.0",
    "socket.io": "^4.8.3",
    "sonos": "^1.14.2",
    "undici": "^6.21.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/dav": "^1.7.7",
    "@types/express": "^4.17.21",
    "@types/multicast-dns": "^7.2.4",
    "@types/node": "^20.11.30",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3"
  }
}
